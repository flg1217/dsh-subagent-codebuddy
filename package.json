{
  "name": "@flg1217/dsh-subagent-codebuddy",
  "version": "0.1.0",
  "description": "CodeBuddy CLI (Tencent) as a dsh LLM provider via ACP: selectable as a main-agent model (the ACP CLI owns the turn and its tools) and as a subagent backend through the generic subagent tool; exposes the CLI model catalog via listModels().",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "link-profile": "node scripts/link-profile.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
  "@deepseek-ai/dsh-llm": "^0.1.3-alpha.2",
  "@deepseek-ai/dsh-settings": "^0.1.3-alpha.2",
  "@deepseek-ai/dsh-subagent": "^0.1.3-alpha.2",
  "@deepseek-ai/dsh-tools": "^0.1.3-alpha.2",
    "@deepseek-ai/schemastery": "^3.0.0",
    "@deepseek-ai/cordis": "^4.0.2",
    "@types/node": "^22.0.0",
    "typescript": "~5.7.2",
    "vitest": "^3.0.5",
  "@deepseek-ai/dsh-util-values": "^0.1.3-alpha.2",
  "@deepseek-ai/dsh-session": "^0.1.3-alpha.2",
    "@deepseek-ai/dsh-session-format-v0-to-v1": "^0.1.3-alpha.2",
  "@deepseek-ai/dsh-agent": "^0.1.3-alpha.2",
  "@deepseek-ai/dsh-jobs": "^0.1.3-alpha.2",
  "@deepseek-ai/dsh-shell": "^0.1.3-alpha.2"
  },
  "files": [
    "lib",
    "src",
    "cordis.patch.yml"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/flg1217/dsh-subagent-codebuddy.git"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "codebuddy",
    "acp",
    "agent-client-protocol",
    "plugin"
  ],
  "peerDependencies": {
  "@deepseek-ai/dsh-llm": "^0.1.3-alpha.2",
  "@deepseek-ai/dsh-settings": "^0.1.3-alpha.2",
  "@deepseek-ai/dsh-subagent": "^0.1.3-alpha.2",
  "@deepseek-ai/dsh-tools": "^0.1.3-alpha.2",
  "@deepseek-ai/dsh-jobs": "^0.1.3-alpha.2",
  "@deepseek-ai/dsh-shell": "^0.1.3-alpha.2",
    "@deepseek-ai/schemastery": "^3.0.0",
    "@deepseek-ai/cordis": ">=0.1.0-rc.6"
  },
  "dependencies": {
    "@flg1217/dsh-mcp": "link:../dsh-mcp"
  }
}
